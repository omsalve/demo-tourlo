# Server-only. Never prefix these with NEXT_PUBLIC_ (or VITE_) or commit their values.

# Enquiry form (Resend). Required: until both are set the form reports that the
# connection is being prepared and the walkthrough stays locked.
RESEND_API_KEY=
# One or more recipients, comma separated.
LEAD_EMAIL_TO=
# Sender on a domain verified in Resend, e.g. "Tourlo Enquiries <enquiries@tourlo.in>".
# If empty, onboarding@resend.dev is used, which only delivers to your own Resend account email.
LEAD_EMAIL_FROM=

# Optional live inventory from Google Sheets. Without it, sample availability is shown.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Optional, public (inlined into the browser bundle at build time).
# The legacy VITE_GA_ID / VITE_BOOKING_URL names are still accepted.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BOOKING_URL=
