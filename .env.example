# Copy to .env.local and fill in. All are optional.
# Where the lead form POSTs JSON. Leave empty to log leads to the console.
VITE_LEAD_WEBHOOK=
# GA4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
VITE_GA_ID=
# Where "Book a full live demo" links to. Defaults to https://tourlo.in
VITE_BOOKING_URL=
