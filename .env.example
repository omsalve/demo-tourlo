# Server-only. Required to activate confirmed enquiry capture and live inventory.
# Never add NEXT_PUBLIC_ (or VITE_) to these keys or commit their values.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Optional, public (inlined into the browser bundle at build time).
# The legacy VITE_GA_ID / VITE_BOOKING_URL names are still accepted.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BOOKING_URL=
